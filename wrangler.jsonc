{
  "name": "chatabot-ai",
  "main": "./worker.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".github/**",
      "package.json",
      "package-lock.json",
      "bun.lock",
      "wrangler.jsonc"
    ]
  },

  "ai": {
    "binding": "AI"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
