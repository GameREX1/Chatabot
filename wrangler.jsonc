{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatabot",
  "main": "./worker.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "ai": {
    "binding": "AI"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
